# Copy to .env.local and adjust.
# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Supabase project (Project Settings > API). Leave unset for local dev without login;
# the backend must then run with AUTH_DISABLED=true (the docker-compose default).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The public "anon" / publishable key. Safe to ship to the browser.
# VITE_SUPABASE_ANON_KEY=
