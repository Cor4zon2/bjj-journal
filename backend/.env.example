# Copy to .env and adjust.
ENVIRONMENT=development
# Plain postgres:// / postgresql:// URLs (as Supabase shows them) are accepted too.
DATABASE_URL=postgresql+psycopg://bjj:bjj@localhost:5432/bjj_journal
# JSON list of origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# --- Auth -------------------------------------------------------------------
# Local dev without Supabase: skip token checks. Refused when ENVIRONMENT=production.
AUTH_DISABLED=true

# With Supabase (required in production):
# SUPABASE_URL=https://<project-ref>.supabase.co
# OWNER_USER_ID=<uuid of your user in Supabase > Authentication > Users>
# Only for projects still on the legacy HS256 JWT secret:
# SUPABASE_JWT_SECRET=
